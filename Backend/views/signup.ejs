<!DOCTYPE html>
<html lang="en" class="">
  <head>
    <meta charset="UTF-8" />
    <title>Sign Up</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: "class",
      };
    </script>
  </head>
  <body
    class="bg-gray-100 dark:bg-gray-900 flex items-center justify-center h-screen"
  >
    <div
      class="w-1/4 bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-md relative"
    >
      <!-- 🔘 Dark Mode Toggle Button -->
      <button
        id="dark-toggle"
        class="absolute top-3 right-3 p-1.5 bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-white rounded-full text-xs hover:scale-105 transition"
      >
        🌙
      </button>

      <h2 class="text-2xl font-bold mb-6 text-center dark:text-white">
        Sign Up
      </h2>

      <form action="/user/signup" method="POST" class="space-y-4">
        <input
          name="name"
          type="text"
          placeholder="Username"
          required
          class="w-full px-4 py-2 border rounded dark:bg-gray-700 dark:text-white"
        />
        <input
          name="email"
          type="email"
          placeholder="Email"
          required
          class="w-full px-4 py-2 border rounded dark:bg-gray-700 dark:text-white"
        />
        <input
          name="password"
          type="password"
          placeholder="Password"
          required
          class="w-full px-4 py-2 border rounded dark:bg-gray-700 dark:text-white"
        />
        <button
          type="submit"
          class="w-full bg-green-600 text-white py-2 rounded hover:bg-green-700"
        >
          Sign Up
        </button>
      </form>

      <p class="mt-4 text-center text-sm text-gray-600 dark:text-gray-300">
        Already have an account?
        <a
          href="/user/login"
          class="text-green-600 dark:text-green-300 hover:underline"
          >Login</a
        >
      </p>
    </div>

    <script>
      document.getElementById("dark-toggle").addEventListener("click", () => {
        document.documentElement.classList.toggle("dark");
      });
    </script>
  </body>
</html>
